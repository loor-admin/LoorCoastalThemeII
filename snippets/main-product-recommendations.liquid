{% assign items = section.settings.recommendations_collection.products %}
{% if section.settings.recommendations_collection == blank %}{% assign items = recommendations.products %}{% endif %}
{% if items != blank %}<section class="pdp-recommendations"><h2>{{ section.settings.recommendations_heading | escape }}</h2><div class="pdp-recommendations__grid">{% assign shown = 0 %}{% for item in items %}{% if item.id != product.id and shown < section.settings.recommendations_limit %}{% assign shown = shown | plus: 1 %}<article><a href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}{% endif %}<h3>{{ item.title | escape }}</h3><p>{{ item.price | money }}</p></a></article>{% endif %}{% endfor %}</div></section>{% endif %}
