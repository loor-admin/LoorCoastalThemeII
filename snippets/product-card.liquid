<article class="product-card"><a class="product-card__image" href="{{ product.url }}">{% if product.featured_media %}{{ product.featured_media.preview_image | image_url: width: 900 | image_tag: widths: '240, 360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: product.featured_media.alt }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}<span class="card-badges">{% unless product.available %}<span class="badge badge--sold">Sold out</span>{% else %}{% if product.compare_at_price > product.price %}<span class="badge">Sale</span>{% endif %}{% if product.metafields.custom.badge.value != blank %}<span class="badge badge--teal">{{ product.metafields.custom.badge.value | escape }}</span>{% endif %}{% endunless %}</span></a><div class="product-card__details"><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><p>{% if product.price_varies %}From {% endif %}{{ product.price | money }} {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</p>{% for option in product.options_with_values %}{% assign option_name = option.name | downcase %}{% if option_name == 'color' or option_name == 'colour' %}<p class="muted">{{ option.values.size }} colors: {% for value in option.values limit: 4 %}{{ value | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>{% endif %}{% endfor %}</div></article>
