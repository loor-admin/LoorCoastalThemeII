<dialog id="SearchDialog-{{ section.id }}" class="search-dialog" aria-labelledby="SearchTitle-{{ section.id }}"><div class="modal__head"><h2 id="SearchTitle-{{ section.id }}">Search</h2><button type="button" data-close-dialog aria-label="Close search">×</button></div>
<predictive-search data-url="{{ routes.predictive_search_url }}" data-search-url="{{ routes.search_url }}"><form action="{{ routes.search_url }}" method="get" role="search"><label for="SearchInput-{{ section.id }}">Search products</label><div class="search-field"><input id="SearchInput-{{ section.id }}" type="search" name="q" autocomplete="off" placeholder="Search sunglasses" aria-controls="SearchResults-{{ section.id }}" aria-describedby="SearchStatus-{{ section.id }}"><input type="hidden" name="options[prefix]" value="last"><button type="button" data-search-clear hidden>Clear</button><button type="submit">Search</button></div></form><p id="SearchStatus-{{ section.id }}" data-search-status role="status" aria-live="polite">Enter at least 3 characters to see suggestions.</p><div id="SearchResults-{{ section.id }}" data-search-results></div></predictive-search></dialog>
