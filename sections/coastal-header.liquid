<div class="announcement"><span>{{ section.settings.left }}</span><span>{{ section.settings.center }}</span><span>{{ section.settings.right }}</span></div><header class="header"><a class="logo" href="{{ routes.root_url }}">LOOR<sup>®</sup></a><nav aria-label="Main navigation">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% else %}<a href="{{ routes.all_products_collection_url }}">New in</a><a href="{{ routes.all_products_collection_url }}">Sunglasses</a><a href="{{ routes.all_products_collection_url }}">Eyeglasses</a>{% endfor %}</nav><div class="actions"><a href="{{ routes.search_url }}" aria-label="Search">⌕</a><a href="{{ routes.account_url }}" aria-label="Account">♙</a><a href="{{ routes.cart_url }}" aria-label="Cart">♧ <small>{{ cart.item_count }}</small></a></div></header>{% schema %}{"name":"Coastal header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},{"type":"text","id":"left","label":"Left announcement","default":"Free shipping over $75"},{"type":"text","id":"center","label":"Center announcement","default":"Summer edit: 30% off selected styles"},{"type":"text","id":"right","label":"Right announcement","default":"Easy 30-day returns"}]}{% endschema %}