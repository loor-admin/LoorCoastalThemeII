<section class="hero" style="background-image:linear-gradient(90deg,rgba(21,39,68,.72),transparent 70%),url({% if section.settings.hero != blank %}{{ section.settings.hero | image_url: width: 2400 }}{% else %}{{ 'hero.png' | asset_url }}{% endif %})"><div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading | escape | newline_to_br }}</h1><p>{{ section.settings.description }}</p><a class="button dark" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">{{ section.settings.button }} <span>→</span></a></div><div class="badge"><strong>UV400</strong><small>100% protection</small></div></section><div class="ticker">MADE FOR EVERY FACE <b>/</b> PREMIUM POLARIZED LENSES <b>/</b> DESIGNED FOR REAL LIFE <b>/</b> MADE FOR EVERY FACE</div><section class="products" id="products"><div class="products-heading"><div><p class="eyebrow">Find your frame</p><h2>{{ section.settings.products_title }}</h2></div><p>Statement shades for slow mornings, long lunches,<br> and everything after.</p></div><div class="product-tools"><span>ALL &nbsp;&nbsp; SQUARE &nbsp;&nbsp; CAT EYE &nbsp;&nbsp; ROUND &nbsp;&nbsp; AVIATOR</span><span>{{ section.settings.collection.products_count }} STYLES</span></div><div class="grid">{% for product in section.settings.collection.products limit: 6 %}<article class="card"><a href="{{ product.url }}"><div class="card-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><div class="card-meta"><strong>{{ product.title }}</strong><strong>{{ product.price | money }}</strong></div><p>{{ product.type }}</p></a></article>{% else %}{% assign names = 'Sora Black,Mila Rose,Noma Tortoise,Lio Silver,Vela Moss,Rina Smoke' | split: ',' %}{% assign images = 'sora.png,mila.png,noma.png,lio.png,vela.png,rina.png' | split: ',' %}{% for name in names %}<article class="card"><div class="card-image"><img src="{{ images[forloop.index0] | asset_url }}" alt="{{ name | escape }} sunglasses" loading="lazy"></div><div class="card-meta"><strong>{{ name }}</strong><strong>—</strong></div><p>Choose a collection in the theme editor</p></article>{% endfor %}{% endfor %}</div></section><section class="fit"><div class="fit-copy"><p class="eyebrow">No guesswork required</p><h2>MEET YOUR<br>PERFECT FIT.</h2><p>Face width, bridge, temple length—we make the measurements make sense. Find your fit in under 60 seconds.</p><a class="button" href="{{ section.settings.fit_link | default: routes.all_products_collection_url }}">Find my fit <span>→</span></a></div><div class="fit-image" style="background-image:url({% if section.settings.fit_image != blank %}{{ section.settings.fit_image | image_url: width: 1800 }}{% else %}{{ 'fit.png' | asset_url }}{% endif %})"><div class="measure first">↔ &nbsp; <b>FRAME WIDTH</b><br> &nbsp;&nbsp;&nbsp; 135 mm</div><div class="measure second">↔ &nbsp; <b>BRIDGE</b><br> &nbsp;&nbsp;&nbsp; 19 mm</div></div></section><section class="benefits"><div><i>♧</i><h3>Free shipping</h3><p>On all orders over $75</p></div><div><i>30</i><h3>Easy returns</h3><p>30 days, no hard feelings</p></div><div><i>UV</i><h3>Full protection</h3><p>UV400 on every lens</p></div><div><i>2Y</i><h3>Built to last</h3><p>2-year frame warranty</p></div></section>{% schema %}{"name":"Coastal homepage","settings":[{"type":"image_picker","id":"hero","label":"Hero image"},{"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"The summer edit · 2025"},{"type":"textarea","id":"heading","label":"Hero heading","default":"GOOD DAYS\nLOOK LIKE THIS."},{"type":"text","id":"description","label":"Hero description","default":"Fresh frames, full color, and nowhere else to be."},{"type":"text","id":"button","label":"Button text","default":"Shop the collection"},{"type":"url","id":"shop_link","label":"Shop link"},{"type":"text","id":"products_title","label":"Products heading","default":"SUNGLASSES"},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"image_picker","id":"fit_image","label":"Fit image"},{"type":"url","id":"fit_link","label":"Fit guide link"}],"presets":[{"name":"Coastal homepage"}]}{% endschema %}