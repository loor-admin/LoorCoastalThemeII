<section class="section container"><div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">View all</a>{% endif %}</div><div class="product-carousel" role="region" aria-label="{{ section.settings.heading | escape }}" tabindex="0">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<p>Choose a collection in the theme editor to feature products here.</p>{% endfor %}</div><div class="trust-strip"><strong>{{ section.settings.trust_heading | escape }}</strong><span>{{ section.settings.trust_text | escape }}</span></div></section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your new favorites"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "trust_heading",
      "label": "Trust heading",
      "default": "Made for everyday adventures"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust text",
      "default": "Find your perfect pair."
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
