<div class="standard-page">{% case request.page_type %}{% when 'product' %}<div class="standard-product"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag }}{% endif %}</div><div><h1>{{ product.title }}</h1><p>{{ product.price | money }}</p>{{ product.description }}{% form 'product', product %}<label for="variant">Choose an option</label><select id="variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select><button class="button dark" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>{% endform %}</div></div>{% when 'collection' %}<h1>{{ collection.title }}</h1><div>{{ collection.description }}</div><div class="grid">{% for product in collection.products %}<article class="card"><a href="{{ product.url }}"><div class="card-image">{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}</div><div class="card-meta"><strong>{{ product.title }}</strong><strong>{{ product.price | money }}</strong></div></a></article>{% else %}<p>No products found.</p>{% endfor %}</div>{% when 'cart' %}<h1>Your cart</h1>{% form 'cart', cart %}{% for item in cart.items %}<div class="cart-item"><a href="{{ item.url }}">{{ item.title }}</a><span>{{ item.final_line_price | money }}</span><label>Quantity <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label><a href="{{ item.url_to_remove }}">Remove</a></div>{% else %}<p>Your cart is empty.</p>{% endfor %}<p>Subtotal: {{ cart.total_price | money }}</p><button class="button" type="submit" name="update">Update cart</button> <button class="button dark" type="submit" name="checkout">Checkout</button>{% endform %}{% when 'search' %}<h1>Search</h1><form action="{{ routes.search_url }}"><input type="search" name="q" value="{{ search.terms | escape }}"><button class="button">Search</button></form>{% if search.performed %}<div class="grid">{% for item in search.results %}<article><a href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 600 | image_tag }}{% endif %}<h2>{{ item.title }}</h2></a></article>{% else %}<p>No results found.</p>{% endfor %}</div>{% endif %}{% when 'page' %}<h1>{{ page.title }}</h1>{{ page.content }}{% when '404' %}<h1>Page not found</h1><a class="button" href="{{ routes.root_url }}">Back to home</a>{% when 'list-collections' %}<h1>Collections</h1><div class="grid">{% for collection in collections %}<a href="{{ collection.url }}"><h2>{{ collection.title }}</h2></a>{% endfor %}</div>{% else %}<h1>{{ page_title }}</h1>{% endcase %}</div>{% schema %}{"name":"Store page","settings":[]}{% endschema %}