{{ 'product-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'main-product.js' | asset_url }}" defer></script>
{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
{%- assign fit_guide = product.metafields.custom.fit_guide.value -%}
<div class="main-product" data-main-product data-section-id="{{ section.id }}" data-money-format="{{ shop.money_format | escape }}" data-add-label="{{ section.settings.add_label | escape }}" data-sold-label="{{ section.settings.sold_out_label | escape }}" data-unavailable-label="{{ section.settings.unavailable_label | escape }}">
{% if section.settings.show_breadcrumbs %}<nav class="pdp-breadcrumb" aria-label="{{ section.settings.home_label | escape }}"><a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a>{% if collection %}<span aria-hidden="true">/</span><a href="{{ collection.url }}">{{ collection.title | escape }}</a>{% endif %}<span aria-hidden="true">/</span><strong>{{ product.title | escape }}</strong></nav>{% endif %}
<div class="pdp">
  <div class="pdp-gallery{% if section.settings.gallery_layout == 'stacked' %} pdp-gallery--stacked{% endif %}" data-gallery>
    <div class="pdp-gallery__stage">
      {% for media in product.media %}<div class="pdp-gallery__slide" data-slide {% if section.settings.gallery_layout == 'carousel' and forloop.first == false %}hidden{% endif %} data-media-id="{{ media.id }}">{% case media.media_type %}{% when 'image' %}{{ media | image_url: width: 1600 | image_tag: widths: '550, 800, 1200, 1600', loading: 'lazy' }}{% when 'video' %}{{ media | video_tag: controls: true }}{% when 'external_video' %}{{ media | external_video_tag }}{% when 'model' %}{{ media | model_viewer_tag }}{% endcase %}</div>{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endfor %}
      {% if section.settings.gallery_layout == 'carousel' and product.media.size > 1 %}<button type="button" class="pdp-gallery__arrow prev" data-gallery-prev aria-label="{{ section.settings.gallery_previous_label | escape }}">←</button><button type="button" class="pdp-gallery__arrow next" data-gallery-next aria-label="{{ section.settings.gallery_next_label | escape }}">→</button><span class="pdp-gallery__count" data-gallery-count>1 / {{ product.media.size }}</span>{% endif %}
    </div>
    {% if section.settings.gallery_layout == 'carousel' and product.media.size > 1 %}<div class="pdp-gallery__thumbs">{% for media in product.media %}<button type="button" class="pdp-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="{{ section.settings.gallery_view_label | escape }} {{ forloop.index }}">{{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt }}</button>{% endfor %}</div>{% endif %}
  </div>
  <div class="pdp-info{% if section.settings.enable_sticky_buy_box %} pdp-info--sticky{% endif %}">
    {% form 'product', product, id: product_form_id, class: 'pdp-form', data-product-form: '' %}
      {% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-select>{% else %}<label class="pdp-variant-label" for="Variant-{{ section.id }}">{{ section.settings.variant_label | escape }}</label><select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == selected_variant %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ section.settings.sold_out_label | escape }}{% endunless %}</option>{% endfor %}</select>{% endif %}
      {% assign below_started = false %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'tech_spec_card', 'dimensions_schematic', 'fit_comparison', 'recommendations', 'reviews_anchor' %}{% assign below_started = true %}
          {% when 'eyebrow_and_title' %}<div {{ block.shopify_attributes }}>{% if product.type != blank %}<p class="pdp-eyebrow">{{ product.type | escape }}</p>{% endif %}<div class="pdp-title-row"><h1>{{ product.title | escape }}{% if product.collections.size > 0 %} <span class="pdp-title-badge">{% for product_collection in product.collections %}<a href="{{ product_collection.url | escape }}">{{ product_collection.title | escape }}</a>{% unless forloop.last %} / {% endunless %}{% endfor %}</span>{% endif %}</h1></div>{% assign subtitle_color = product.metafields.custom.color.value %}{% assign lens_category_metafield = product.metafields.shopify['lens-color'] %}{% if lens_category_metafield.value == blank %}{% assign lens_category_metafield = product.metafields.shopify['eyewear-lens-color'] %}{% endif %}{% capture category_lens_color %}{% if lens_category_metafield.list? %}{% assign lens_separator = "" %}{% for lens_entry in lens_category_metafield.value %}{% assign lens_label = lens_entry.label.value %}{% if lens_label != blank %}{{ lens_separator }}{{ lens_label }}{% assign lens_separator = ", " %}{% endif %}{% endfor %}{% else %}{{ lens_category_metafield.value.label.value }}{% endif %}{% endcapture %}{% assign category_lens_color = category_lens_color | strip %}{% assign subtitle_lens_color = category_lens_color | default: product.metafields.custom.lens_color.value %}{% assign subtitle_color_index = -1 %}{% assign subtitle_lens_index = -1 %}{% for option in product.options_with_values %}{% assign subtitle_option_name = option.name | downcase | strip %}{% if subtitle_option_name == 'color' or subtitle_option_name == 'colour' %}{% assign subtitle_color = option.selected_value %}{% assign subtitle_color_index = forloop.index0 %}{% endif %}{% endfor %}<p class="pdp-subtitle" data-product-subtitle data-color-index="{{ subtitle_color_index }}" data-lens-index="{{ subtitle_lens_index }}" data-color-fallback="{{ product.metafields.custom.color.value | escape }}" data-lens-fallback="{{ subtitle_lens_color | escape }}" data-lens-suffix="{{ section.settings.lens_suffix | escape }}"{% if subtitle_color == blank and subtitle_lens_color == blank %} hidden{% endif %}>{{ subtitle_color | escape }}{% if subtitle_color != blank and subtitle_lens_color != blank %} / {% endif %}{{ subtitle_lens_color | escape }}{% if subtitle_lens_color != blank and section.settings.lens_suffix != blank %} {{ section.settings.lens_suffix | escape }}{% endif %}</p>{% if section.settings.show_rating_anchor and product.metafields.reviews.rating.value != blank %}<a class="pdp-rating" href="#{{ section.settings.reviews_anchor_id | escape }}">{% assign rating_percent = product.metafields.reviews.rating.value.rating | times: 100.0 | divided_by: product.metafields.reviews.rating.value.scale_max | at_most: 100 | at_least: 0 %}<span class="pdp-stars" aria-hidden="true">☆☆☆☆☆<span style="width: {{ rating_percent }}%">★★★★★</span></span><span>{{ product.metafields.reviews.rating.value.rating | escape }}</span>{% if product.metafields.reviews.rating_count.value != blank %}<span class="pdp-rating-count">{{ product.metafields.reviews.rating_count.value | escape }} {{ section.settings.reviews_link_label | escape }}</span>{% endif %}</a>{% endif %}</div>
          {% when 'price_and_installments' %}<div {{ block.shopify_attributes }}><p class="pdp-price"><span data-price>{{ selected_variant.price | money }}</span> <s data-compare {% unless selected_variant.compare_at_price > selected_variant.price %}hidden{% endunless %}>{% if selected_variant.compare_at_price > selected_variant.price %}{{ selected_variant.compare_at_price | money }}{% endif %}</s> <span class="pdp-sale" data-sale {% unless selected_variant.compare_at_price > selected_variant.price %}hidden{% endunless %}>{{ section.settings.sale_label | escape }}</span></p>{% if block.settings.installment_subtext != blank %}<div class="pdp-installments">{{ block.settings.installment_subtext }}</div>{% endif %}</div>
          {% when 'product_details' %}<div {{ block.shopify_attributes }}>{% if block.settings.show_vendor and product.vendor != blank %}<div class="pdp-description"><p>{{ block.settings.vendor_label | escape }}{% if block.settings.vendor_label != blank %}: {% endif %}{{ product.vendor | escape }}</p></div>{% endif %}</div>
          {% when 'short_description' %}<div class="pdp-description" {{ block.shopify_attributes }}>{% if block.settings.description_source != blank %}{{ block.settings.description_source }}{% else %}{{ product.description }}{% endif %}</div>
          {% when 'variant_picker' %}{% unless product.has_only_default_variant %}<div data-picker {{ block.shopify_attributes }}>{% for option in product.options_with_values %}{% assign option_index = forloop.index0 %}{% assign option_name = option.name | downcase | strip %}{% if option_name == "lens color" or option_name == "lens colour" %}<select data-option-index="{{ option_index }}" hidden aria-hidden="true" tabindex="-1">{% for value in option.values %}<option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value | escape }}</option>{% endfor %}</select>{% else %}{% assign size_name = block.settings.size_option_name | downcase | strip %}{% assign color_name = block.settings.color_option_name | downcase | strip %}<fieldset class="pdp-option"><legend class="pdp-option__header"><span class="pdp-option__heading">{{ option.name | escape }} <span data-option-label="{{ option_index }}">{{ option.selected_value | escape }}</span></span>{% if option_name == size_name and block.settings.show_size_guide_inline and fit_guide != blank %}<button type="button" class="pdp-fit-link" data-fit-open aria-haspopup="dialog" aria-controls="FitGuide-{{ section.id }}">{{ section.settings.fit_guide_label | escape }}</button>{% endif %}</legend>{% if block.settings.picker_type == 'dropdowns' %}<select data-option-index="{{ option_index }}" aria-label="{{ option.name | escape }}">{% for value in option.values %}<option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value | escape }}</option>{% endfor %}</select>{% else %}<div class="pdp-option__values{% if option_name == color_name %} pdp-option__values--color{% elsif option_name == size_name %} pdp-option__values--size{% endif %}">{% for value in option.values %}<label><input type="radio" name="option-{{ section.id }}-{{ option_index }}" value="{{ value | escape }}" data-option-index="{{ option_index }}" {% if option.selected_value == value %}checked{% endif %}><span>{% if option_name == color_name and value.swatch.color != blank %}<i style="--swatch-color: {{ value.swatch.color }}"></i><span class="pdp-swatch-label">{{ value | escape }}</span>{% elsif option_name == color_name and value.swatch.image != blank %}<i style="--swatch-image: url({{ value.swatch.image | image_url: width: 64 }})"></i><span class="pdp-swatch-label">{{ value | escape }}</span>{% else %}{{ value | escape }}{% endif %}</span></label>{% endfor %}</div>{% endif %}</fieldset>{% endif %}{% endfor %}</div>{% endunless %}
          {% when 'buy_buttons' %}<div {{ block.shopify_attributes }}><div class="pdp-purchase">{% if block.settings.show_quantity_selector %}<div class="pdp-quantity"><button type="button" data-quantity-change="-1" aria-label="{{ section.settings.quantity_label | escape }} −">−</button><input type="number" name="quantity" value="1" min="1" aria-label="{{ section.settings.quantity_label | escape }}"><button type="button" data-quantity-change="1" aria-label="{{ section.settings.quantity_label | escape }} +">+</button></div>{% endif %}<button class="pdp-add" type="submit" data-add data-show-price="{{ block.settings.show_price_in_button }}" {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}{{ section.settings.add_label | escape }}{% if block.settings.show_price_in_button %} — {{ selected_variant.price | money }}{% endif %}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}</button></div>{% if block.settings.show_dynamic_checkout %}{{ form | payment_button }}{% endif %}{% if block.settings.stock_message != blank %}<p class="pdp-stock" data-stock{% unless selected_variant.available %} hidden{% endunless %}><span aria-hidden="true">●</span> {{ block.settings.stock_message | escape }}</p>{% endif %}</div>
          {% when 'trust_badges' %}<div class="pdp-perks" {{ block.shopify_attributes }}>{% for i in (1..4) %}{% assign icon_key = 'badge_' | append: i | append: '_icon' %}{% assign text_key = 'badge_' | append: i | append: '_text' %}{% assign icon = block.settings[icon_key] %}{% assign label = block.settings[text_key] %}{% if icon != blank or label != blank %}<span>{% if icon != blank %}{{ icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}{% endif %}{{ label | escape }}</span>{% endif %}{% endfor %}</div>
          {% when '@app' %}{% unless below_started %}<div {{ block.shopify_attributes }}>{% render block %}</div>{% endunless %}
        {% endcase %}
      {% endfor %}
    {% endform %}
    <script type="application/json" data-variants>{{ product.variants | json }}</script>
  </div>
</div>
{% if fit_guide != blank %}
  <dialog id="FitGuide-{{ section.id }}" class="pdp-fit-dialog" aria-labelledby="FitGuideTitle-{{ section.id }}" data-fit-dialog>
    <div class="pdp-fit-dialog__header">
      <h2 id="FitGuideTitle-{{ section.id }}">{{ fit_guide.heading.value | default: section.settings.fit_guide_label | escape }}</h2>
      <button type="button" class="pdp-fit-dialog__close" data-fit-close aria-label="{{ section.settings.fit_close_label | escape }}" autofocus>×</button>
    </div>
    {% if fit_guide.instructions.value != blank %}<div class="pdp-fit-dialog__instructions">{{ fit_guide.instructions | metafield_tag }}</div>{% endif %}
    {% if fit_guide.diagram.value != blank %}{{ fit_guide.diagram.value | image_url: width: 1200 | image_tag: class: 'pdp-fit-dialog__diagram', loading: 'lazy' }}{% endif %}
    <dl class="pdp-fit-dialog__measurements">
      {% if fit_guide.small_measurements.value != blank or fit_guide.small_fit_note.value != blank %}<div><dt>{{ section.settings.fit_small_label | escape }}</dt><dd>{% if fit_guide.small_measurements.value != blank %}<span>{{ fit_guide.small_measurements.value | escape }}</span>{% endif %}{% if fit_guide.small_fit_note.value != blank %}<p>{{ fit_guide.small_fit_note.value | escape }}</p>{% endif %}</dd></div>{% endif %}
      {% if fit_guide.standard_measurements.value != blank or fit_guide.standard_fit_note.value != blank %}<div><dt>{{ section.settings.fit_standard_label | escape }}</dt><dd>{% if fit_guide.standard_measurements.value != blank %}<span>{{ fit_guide.standard_measurements.value | escape }}</span>{% endif %}{% if fit_guide.standard_fit_note.value != blank %}<p>{{ fit_guide.standard_fit_note.value | escape }}</p>{% endif %}</dd></div>{% endif %}
      {% if fit_guide.large_measurements.value != blank or fit_guide.large_fit_note.value != blank %}<div><dt>{{ section.settings.fit_large_label | escape }}</dt><dd>{% if fit_guide.large_measurements.value != blank %}<span>{{ fit_guide.large_measurements.value | escape }}</span>{% endif %}{% if fit_guide.large_fit_note.value != blank %}<p>{{ fit_guide.large_fit_note.value | escape }}</p>{% endif %}</dd></div>{% endif %}
    </dl>
  </dialog>
{% endif %}
{% assign below_started = false %}{% assign specs_open = false %}
{% assign product_highlights = product.metafields.custom.product_highlights.value %}
{% assign highlights_rendered = false %}
{% for block in section.blocks %}
  {% if block.type == 'tech_spec_card' %}
    {% assign below_started = true %}
    {% if product_highlights != blank %}
      {% unless highlights_rendered %}
        {% assign highlights_rendered = true %}
        <section class="pdp-details" {{ block.shopify_attributes }}>
          <h2>{{ section.settings.specs_heading | escape }}</h2>
          <div class="pdp-highlights">
            {% for highlight in product_highlights %}
              <details class="pdp-highlight">
                <summary>
                  {% if highlight.icon.value != blank %}
                    {{ highlight.icon.value | image_url: width: 80 | image_tag: class: 'pdp-highlight__icon', loading: 'lazy', alt: '' }}
                  {% endif %}
                  <strong>{{ highlight.title.value | escape }}</strong>
                </summary>
                <div class="pdp-highlight__body">
                  {% if highlight.description.value != blank %}
                    {{ highlight.description | metafield_tag }}
                  {% endif %}
                  {% if highlight.image.value != blank %}
                    {{ highlight.image.value | image_url: width: 1200 | image_tag: class: 'pdp-highlight__image', widths: '360, 720, 1200', loading: 'lazy' }}
                  {% endif %}
                </div>
              </details>
            {% endfor %}
          </div>
        </section>
      {% endunless %}
    {% else %}
      {% unless specs_open %}<section class="pdp-details"><h2>{{ section.settings.specs_heading | escape }}</h2><div class="pdp-features">{% assign specs_open = true %}{% endunless %}
      <article {{ block.shopify_attributes }}>{% if block.settings.spec_icon != blank %}{{ block.settings.spec_icon | image_url: width: 100 | image_tag: loading: 'lazy', alt: '' }}{% endif %}<h3>{{ block.settings.spec_title | escape }}</h3><div>{{ block.settings.spec_description }}</div></article>
    {% endif %}
  {% else %}
    {% if specs_open %}</div></section>{% assign specs_open = false %}{% endif %}
    {% case block.type %}
      {% when 'dimensions_schematic' %}{% assign below_started = true %}<section class="pdp-dimensions" {{ block.shopify_attributes }}>{% if block.settings.diagram_image != blank %}{{ block.settings.diagram_image | image_url: width: 1400 | image_tag: loading: 'lazy' }}{% endif %}<div class="pdp-dimensions__values">{% for i in (1..4) %}{% assign label_key = 'measurement_' | append: i | append: '_label' %}{% assign value_key = 'measurement_' | append: i | append: '_value' %}{% if block.settings[label_key] != blank or block.settings[value_key] != blank %}<div><span>{{ block.settings[label_key] | escape }}</span> <strong>{{ block.settings[value_key] | escape }}</strong></div>{% endif %}{% endfor %}</div></section>
      {% when 'fit_comparison' %}{% assign below_started = true %}{% if section.settings.fit_comparison_image != blank %}<section class="pdp-fit" {{ block.shopify_attributes }}><div><h2>{{ section.settings.fit_heading | escape }}</h2>{% if section.settings.fit_guide_link != blank %}<a href="{{ section.settings.fit_guide_link }}">{{ section.settings.fit_guide_label | escape }}</a>{% endif %}</div>{{ section.settings.fit_comparison_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}</section>{% endif %}
      {% when 'recommendations' %}{% assign below_started = true %}<div {{ block.shopify_attributes }} data-recommendations data-use-api="{% if section.settings.recommendations_collection == blank %}true{% else %}false{% endif %}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.recommendations_limit }}&intent=related">{% render 'main-product-recommendations', section: section, product: product, recommendations: recommendations %}</div>
      {% when 'reviews_anchor' %}{% assign below_started = true %}<section class="pdp-reviews" id="{{ section.settings.reviews_anchor_id | escape }}" {{ block.shopify_attributes }}><h2>{{ section.settings.reviews_section_heading | escape }}</h2></section>
      {% when '@app' %}{% if below_started %}<div class="pdp-app-block" {{ block.shopify_attributes }}>{% render block %}</div>{% endif %}
    {% endcase %}
  {% endif %}
{% endfor %}{% if specs_open %}</div></section>{% endif %}
{% if section.settings.enable_mobile_sticky_bar %}<div class="pdp-sticky-bar" data-sticky-bar>{% if product.featured_image %}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.featured_image.alt }}{% endif %}<div><strong>{{ product.title | escape }}</strong><span data-sticky-price>{{ selected_variant.price | money }}</span></div><button type="submit" form="{{ product_form_id }}" data-sticky-add {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}{{ section.settings.add_label | escape }}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}</button></div>{% endif %}
</div>
{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "carousel",
          "label": "Thumbnail carousel"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_buy_box",
      "label": "Sticky buy box",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_sticky_bar",
      "label": "Mobile sticky bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "product_eyebrow",
      "label": "Product eyebrow (legacy)",
      "info": "The product type now appears above the title."
    },
    {
      "type": "text",
      "id": "product_badge",
      "label": "Product badge (legacy)",
      "info": "The product badge now displays links to the product collections."
    },
    {
      "type": "text",
      "id": "product_subtitle",
      "label": "Product subtitle",
      "info": "Legacy setting; the subtitle is generated from the Color and Lens Color options or corresponding custom metafields."
    },
    {
      "type": "text",
      "id": "lens_suffix",
      "label": "Lens color suffix",
      "default": "Lens"
    },
    {
      "type": "text",
      "id": "fit_guide_label",
      "label": "Fit guide label",
      "default": "Size & Fit Guide"
    },
    {
      "type": "text",
      "id": "fit_close_label",
      "label": "Close fit guide label",
      "default": "Close size guide"
    },
    {
      "type": "text",
      "id": "fit_small_label",
      "label": "Small fit label",
      "default": "Small"
    },
    {
      "type": "text",
      "id": "fit_standard_label",
      "label": "Standard fit label",
      "default": "Standard"
    },
    {
      "type": "text",
      "id": "fit_large_label",
      "label": "Large fit label",
      "default": "Large"
    },
    {
      "type": "url",
      "id": "fit_guide_link",
      "label": "Fit guide link",
      "info": "Connect a product URL metafield."
    },
    {
      "type": "image_picker",
      "id": "fit_comparison_image",
      "label": "Fit comparison image",
      "info": "Connect a product file metafield."
    },
    {
      "type": "text",
      "id": "recommendations_heading",
      "label": "Recommendations heading",
      "default": "YOU MAY ALSO LIKE"
    },
    {
      "type": "collection",
      "id": "recommendations_collection",
      "label": "Recommendations collection",
      "info": "Connect a product collection reference metafield."
    },
    {
      "type": "range",
      "id": "recommendations_limit",
      "label": "Recommendations limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_rating_anchor",
      "label": "Show rating anchor",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_section_heading",
      "label": "Reviews heading",
      "default": "CUSTOMER REVIEWS"
    },
    {
      "type": "text",
      "id": "reviews_anchor_id",
      "label": "Reviews anchor ID",
      "default": "shopify-product-reviews",
      "info": "Use the ID of the review destination, without #."
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to bag label",
      "default": "Add to bag"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "Unavailable label",
      "default": "Unavailable"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "variant_label",
      "label": "Variant label",
      "default": "Variant"
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Breadcrumb home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "gallery_previous_label",
      "label": "Previous image label",
      "default": "Previous image"
    },
    {
      "type": "text",
      "id": "gallery_next_label",
      "label": "Next image label",
      "default": "Next image"
    },
    {
      "type": "text",
      "id": "gallery_view_label",
      "label": "View image label",
      "default": "View image"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Sale label",
      "default": "Sale"
    },
    {
      "type": "text",
      "id": "specs_heading",
      "label": "Specifications heading",
      "default": "DETAILS THAT DO MORE."
    },
