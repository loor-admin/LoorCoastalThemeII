<section class="section container"><div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2></div><div class="tile-grid">{% for block in section.blocks %}<article class="category-tile" {{ block.shopify_attributes }}><a href="{{ block.settings.link | default: routes.all_products_collection_url }}"><div class="tile-image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 750px) 33vw, 80vw', loading: 'lazy' }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</div><h3>{{ block.settings.heading | escape }} <span aria-hidden="true">↗</span></h3></a></article>{% endfor %}</div></section>
{% schema %}
{
  "name": "Category tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop your way"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop sunglasses"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles"
    }
  ]
}
{% endschema %}
