<section class="campaign-hero{% if section.settings.image == blank %} campaign-hero--empty{% endif %}"><div class="hero-media">{% if section.settings.image != blank %}<picture>{% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', fetchpriority: 'high', alt: section.settings.image.alt }}</picture>{% endif %}</div><div class="hero-content"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p>{% if section.settings.link != blank %}<a class="button" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Campaign hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Offer",
      "default": "Made for brighter days"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your sunny side"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "Frames for every version of you."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Campaign hero"
    }
  ]
}
{% endschema %}
